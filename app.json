{
  "expo": {
    "name": "Bíblia Jornada",
    "slug": "jornada-biblica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.decleones.jornadabiblica",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.decleones.jornadabiblica",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F8FA"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Bíblia Jornada",
      "shortName": "Bíblia Jornada",
      "description": "Bíblia, leitura e jornada: uma experiência de leitura bíblica, constância e crescimento na Palavra.",
      "display": "standalone",
      "themeColor": "#0D2B45",
      "backgroundColor": "#F7F8FA",
      "lang": "pt-BR",
      "startUrl": "/",
      "orientation": "portrait",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F7F8FA"
      }
    },
    "extra": {
      "eas": {
        "projectId": "b2f8e0ba-ce17-40ad-a27b-ad5ad4591224"
      }
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
